<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CCD - Centro Calcolo Dati & Condomini di Cozzolino Ciro </title>
    <style>
        /* Reset e Variabili Aziendali */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        :root {
            --blue-dark: #0b192c;   
            --blue-light: #1e3e62;  
            --red: #e63946;         
            --red-hover: #b81d24;   
            --yellow: #ffb703;      
            --light: #f8fafc;
            --text-dark: #0f172a;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background-color: var(--light);
            color: var(--text-dark);
            line-height: 1.6;
        }

        /* Navbar */
        header {
            background: rgba(11, 25, 44, 0.95);
            position: fixed;
            width: 100%;
            top: 0;
            z-index: 1000;
            backdrop-filter: blur(10px);
            border-bottom: 3px solid var(--yellow);
        }
        .nav-container {
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 2rem;
            position: relative;
        }
        .logo {
            color: #fff;
            font-size: 1.8rem;
            font-weight: bold;
            letter-spacing: 2px;
            z-index: 1001;
        }
        .logo span { color: var(--red); }
        
        /* Menu Desktop */
        .nav-menu {
            display: flex;
            list-style: none;
            align-items: center;
        }
        .nav-menu li {
            margin-left: 1.5rem;
        }
        .nav-menu a {
            color: #cbd5e1;
            text-decoration: none;
            padding: 0.5rem 0;
            transition: color 0.3s;
            font-weight: 600;
            display: block;
        }
        .nav-menu a:hover { color: var(--yellow); }
        
        /* Pulsante Area Riservata in Navbar */
        .nav-menu .btn-nav {
            background: var(--red);
            color: white;
            padding: 0.5rem 1rem;
            border-radius: 4px;
            transition: background 0.3s;
        }
        .nav-menu .btn-nav:hover {
            background: var(--red-hover);
            color: white;
        }

        /* Hamburger Menu Icon (Mobile) */
        .hamburger {
            display: none;
            cursor: pointer;
            background: none;
            border: none;
            z-index: 1001;
            padding: 0.5rem;
        }
        .bar {
            display: block;
            width: 28px;
            height: 3px;
            margin: 6px auto;
            transition: all 0.3s ease-in-out;
            background-color: #fff;
            border-radius: 2px;
        }
        /* Sezioni Generiche */
        section {
            padding: 120px 2rem 80px;
            max-width: 1200px;
            margin: 0 auto;
        }
        .section-title {
            text-align: center;
            font-size: 2.5rem;
            margin-bottom: 1.5rem;
            position: relative;
            color: var(--blue-dark);
        }
        .section-title::after {
            content: '';
            display: block;
            width: 60px;
            height: 4px;
            background: var(--red);
            margin: 10px auto 0;
            border-radius: 2px;
        }
        .section-subtitle {
            text-align: center;
            max-width: 700px;
            margin: 0 auto 3rem;
            color: #475569;
            font-size: 1.1rem;
        }

        /* Hero Section */
        #home {
            background: linear-gradient(135deg, var(--blue-dark) 0%, var(--blue-light) 100%);
            color: #fff;
            min-height: 100vh;
            display: flex;
            align-items: center;
            text-align: center;
            max-width: 100%;
            padding-top: 80px;
        }
        .hero-content {
            max-width: 800px;
            margin: 0 auto;
            padding: 0 2rem;
        }
        .hero-content h1 {
            font-size: 3.5rem;
            margin-bottom: 1.5rem;
            font-weight: 800;
        }
        .hero-content h1 span { color: var(--yellow); }
        .hero-content p {
            font-size: 1.25rem;
            color: #cbd5e1;
            margin-bottom: 2.5rem;
        }
        .btn {
            background: var(--red);
            color: #fff;
            padding: 0.85rem 2.5rem;
            border: none;
            border-radius: 5px;
            font-size: 1rem;
            font-weight: bold;
            cursor: pointer;
            text-decoration: none;
            transition: background 0.3s, transform 0.2s;
            display: inline-block;
            box-shadow: 0 4px 15px rgba(230, 57, 70, 0.4);
        }
        .btn:hover { 
            background: var(--red-hover); 
            transform: translateY(-2px);
        }

        /* Griglie e Card Generiche */
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
        }
        .card {
            background: #fff;
            padding: 2.5rem;
            border-radius: 10px;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
            transition: transform 0.3s, border-top 0.3s;
            border-top: 4px solid var(--blue-light);
        }
        .card:hover { 
            transform: translateY(-5px); 
            border-top: 4px solid var(--red);
        }
        .card h3 { 
            margin-bottom: 1rem; 
            font-size: 1.4rem;
            color: var(--blue-dark);
        }

        /* Pagina Condominio & Login */
        #condominio {
            background-color: #f1f5f9;
            max-width: 100%;
        }
        .condo-container {
            max-width: 1200px;
            margin: 0 auto;
        }
        
        /* Blocco Login Condòmini */
        .login-box {
            background: var(--blue-dark);
            color: white;
            border-radius: 10px;
            padding: 3rem;
            margin-top: 4rem;
            box-shadow: 0 10px 25px rgba(11, 25, 44, 0.2);
            border-left: 5px solid var(--yellow);
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 3rem;
            align-items: center;
        }
        .login-info h3 {
            color: var(--yellow);
            font-size: 1.8rem;
            margin-bottom: 1rem;
        }
        .login-info p { color: #cbd5e1; }
        .login-form .form-group label { color: #cbd5e1; }
        .login-form input {
            background: #1e293b;
            border: 1px solid var(--blue-light);
            color: white;
            width: 100%;
            padding: 0.75rem;
            border-radius: 5px;
            transition: border-color 0.3s;
        }
        .login-form input:focus {
            border-color: var(--yellow);
            background: #0f172a;
            outline: none;
        }

        /* Pagina Sviluppo Informatica */
        #programmazione {
            max-width: 100%;
        }
        .prog-container {
            max-width: 1200px;
            margin: 0 auto;
        }
        .tech-tag {
            display: inline-block;
            background: var(--blue-dark);
            color: var(--yellow);
            padding: 0.2rem 0.6rem;
            border-radius: 4px;
            font-size: 0.85rem;
            font-weight: bold;
            margin-top: 1rem;
            margin-right: 0.5rem;
        }

        /* Sezione Prezzi */
        #prezzi {
            background-color: #f1f5f9;
            max-width: 100%;
        }
        .table-container {
            max-width: 1000px;
            margin: 0 auto;
            background: #fff;
            padding: 2rem;
            border-radius: 10px;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
            overflow-x: auto; 
        }
        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }
        th, td {
            padding: 1rem 1.5rem;
            border-bottom: 1px solid #e2e8f0;
        }
        th {
            background-color: var(--blue-dark);
            color: #fff;
            font-weight: 600;
        }
        th:first-child { border-radius: 5px 0 0 0; }
        th:last-child { border-radius: 0 5px 0 0; color: var(--yellow); }
        tr:hover { background-color: #f8fafc; }
        .price-tag {
            font-weight: bold;
            color: var(--red);
            white-space: nowrap;
        }
        .category-row {
            background-color: #e2e8f0;
            font-weight: bold;
            color: var(--blue-dark);
        }

        /* Contatti */
        #contact {
            max-width: 100%;
        }
        .contact-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 4rem;
            max-width: 1200px;
            margin: 0 auto;
        }
        .contact-info h3 {
            color: var(--blue-dark);
            margin-bottom: 1rem;
        }
        .form-group { margin-bottom: 1.5rem; }
        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 600;
            color: var(--blue-dark);
        }
        .form-group input, .form-group textarea, .form-group select {
            width: 100%;
            padding: 0.75rem;
            border: 2px solid #cbd5e1;
            border-radius: 5px;
            transition: border-color 0.3s;
        }
        .form-group input:focus, .form-group textarea:focus, .form-group select:focus {
            outline: none;
            border-color: var(--blue-light);
        }

        /* Footer */
        footer {
            background: var(--blue-dark);
            color: #94a3b8;
            text-align: center;
            padding: 2rem;
            max-width: 100%;
            border-top: 4px solid var(--red);
        }

        /* Responsive Mobile Styles */
        @media (max-width: 992px) {
            .login-box {
                grid-template-columns: 1fr;
                padding: 2rem;
                gap: 2rem;
            }
        }
        @media (max-width: 768px) {
            .hero-content h1 { font-size: 2.3rem; }
            .hamburger { display: block; }
            .nav-menu {
                position: fixed;
                left: -100%;
                top: 0;
                flex-direction: column;
                background-color: var(--blue-dark);
                width: 100%;
                height: 100vh;
                text-align: center;
                transition: 0.3s;
                box-shadow: 0 10px 27px rgba(0, 0, 0, 0.05);
                justify-content: center;
                padding: 2rem;
            }
            .nav-menu.active { left: 0; }
            .nav-menu li { margin: 1.5rem 0; margin-left: 0; }
            .nav-menu a { font-size: 1.5rem; }
            .nav-menu .btn-nav { background: transparent; color: #cbd5e1; padding: 0; }
            .nav-menu .btn-nav:hover { background: transparent; color: var(--yellow); }
            .hamburger.active .bar:nth-child(2) { opacity: 0; }
            .hamburger.active .bar:nth-child(1) { transform: translateY(9px) rotate(45deg); background-color: var(--red); }
            .hamburger.active .bar:nth-child(3) { transform: translateY(-9px) rotate(-45deg); background-color: var(--red); }
        }
    </style>
</head>
<body>

    <header>
        <div class="nav-container">
            <div class="logo">C<span>CC</span></div>
            
            <button class="hamburger" aria-label="Menu di navigazione">
